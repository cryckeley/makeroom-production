# GoDaddy (Apache) settings for the static ReAlto Partners site
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Old page names from the first draft
Redirect 301 /about.html /dan-gomer.html
Redirect 301 /join.html /join-exp-realty-team.html

# Serve llms.txt as plain UTF-8 text
AddType "text/plain; charset=utf-8" .txt
